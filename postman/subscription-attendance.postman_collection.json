{
  "info": {
    "name": "MealCircle Subscription Attendance",
    "_postman_id": "7a2c5c48-6d2d-4c8d-b48d-9f4e8a1f1d3a",
    "description": "Collection to test subscription attendance routes with absent/present and 3 PM cutoff behavior.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Mark Absent (Before 3 PM)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/subscription/{{subscriptionId}}/absent?date={{todayDate}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "subscription",
            "{{subscriptionId}}",
            "absent"
          ],
          "query": [
            {
              "key": "date",
              "value": "{{todayDate}}"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Mark Absent (After 3 PM -> Auto Present)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/subscription/{{subscriptionId}}/absent?date={{todayDate}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "subscription",
            "{{subscriptionId}}",
            "absent"
          ],
          "query": [
            {
              "key": "date",
              "value": "{{todayDate}}"
            }
          ]
        }
      },
      "response": []
    },
    {
